# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable here maps 1:1 to a field in app/core/config.py — that
# file is the source of truth if this ever drifts.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME="Finance AI Platform"
APP_ENVIRONMENT=local          # local | development | staging | production | test
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:3000"]
# Number of reverse proxies you operate in front of the API (1 = the bundled nginx frontend).
# X-Forwarded-For is trusted for exactly that many right-most entries; 0 ignores the header.
# Leave at 0 if the API is reachable directly by clients, otherwise they could forge their address.
APP_TRUSTED_PROXY_HOPS=0

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=local_only_change_me
DB_NAME=finance_ai_db
DB_ECHO_SQL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Broker (event bus / Celery) ---
BROKER_PROVIDER=in_memory      # in_memory | rabbitmq | kafka
BROKER_URL=amqp://localhost:5672//

# --- Qdrant (vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Security ---
SECURITY_ALLOW_PUBLIC_REGISTRATION=false
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Staging and production refuse to start unless this is at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY_JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM providers (fill in whichever you have keys for) ---
LLM_DEFAULT_PROVIDER=groq
LLM_GROQ_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_OPENAI_API_KEY=
LLM_GEMINI_API_KEY=

# --- SAP Business One (Phase 2 — leave disabled until integration begins) ---
SAP_ENABLED=false
SAP_SERVICE_LAYER_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
# Keep TLS certificate validation enabled; do not bypass certificate errors.
SAP_VERIFY_SSL=true
# SAP's own G/L account code for cash/bank (NOT this platform's internal
# posting_service account codes — a completely different chart of accounts).
# Required before payment sync will work; deliberately has no default.
SAP_DEFAULT_CASH_ACCOUNT_CODE=

# --- Voice AI (Phase 2 — leave disabled until integration begins) ---
VOICE_ENABLED=false

# --- Frontend (build time, Vite). Never put secrets in VITE_ variables: they ship to the browser. ---
# VITE_API_BASE_URL=/api/v1
# Minutes of inactivity before the browser signs the user out (0 disables).
# VITE_IDLE_TIMEOUT_MINUTES=30
